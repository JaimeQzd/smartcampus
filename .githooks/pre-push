#!/bin/sh

echo "Ejecutando comprobaciones pre-push..."

#ejecutamos todos los tests del proyecto, con unitarios e integracion
python -m pytest -v

#comprobamos si alguno de los tests ha fallado
if [ $? -ne 0 ]; then
    echo "Push rechazado: existen tests fallidos."
    exit 1
fi

#si todos los tests pasan dejamos hacer el push
echo "Todos los tests superados."
exit 0